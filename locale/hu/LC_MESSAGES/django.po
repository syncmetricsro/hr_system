msgstr "főkönyvi tételek"

#: features/advances/providers.py:52
msgid "Ledger deductions"
msgstr "Könyvelési levonások"

#: features/advances/services.py:61
msgid "Amount must be positive — meaning lives in the entry type."
msgstr ""
"Az összegnek pozitívnak kell lennie — a jelentést a tétel típusa hordozza."

#: features/advances/services.py:67
#, python-format
msgid "%(t)s entries carry pay effect %(e)s (or none)."
msgstr "A(z) %(t)s tételek bérhatása %(e)s (vagy nincs)."

#: features/advances/services.py:98
msgid "Only open entries can be cancelled; settled entries need a reversal."
msgstr "Csak nyitott tétel törölhető; a rendezett tételhez sztornó kell."

#: features/advances/services.py:132
msgid ""
"This entry has already been settled with pay and cannot be deleted. Record a "
"reversal instead."
msgstr ""
"Ez a tétel már el lett számolva a bérrel, ezért nem törölhető. Rögzítsen "
"helyette sztornót."

#: features/advances/services.py:141
msgid "Delete the reversal of this entry first, then delete the entry."
msgstr "Előbb a tétel sztornóját törölje, utána magát a tételt."

#: features/advances/services.py:180
msgid "This cycle has been settled with pay and cannot be reopened."
msgstr "Ez a ciklus már el lett számolva a bérrel, ezért nem nyitható újra."

#: features/advances/services.py:185
#, python-format
msgid ""
"The %(key)s cycle closed on %(end)s and can no longer be reopened. Its "
"entries are collected by the next run, %(next_key)s, which covers "
"%(next_start)s to %(next_end)s."
msgstr ""
"A(z) %(key)s ciklus %(end)s napon lezárult, és már nem nyitható újra. "
"Tételeit a következő futtatás, a(z) %(next_key)s szedi össze, amely a "
"%(next_start)s – %(next_end)s időszakot fedi le."

