msgid "Open People filtered to this lifecycle status."
msgstr "Nyissa meg a személylistát erre az életciklus-állapotra szűrve."

#: core/ui/views.py:129
#, python-format
msgid "View inactive people: %(reason)s"
msgstr "Inaktív személyek megtekintése: %(reason)s"

#: core/ui/views.py:132
msgid "Open People filtered to this inactive reason."
msgstr "Nyissa meg a személylistát erre az inaktivitási okra szűrve."

