msgid "View %(status)s people"
msgstr "Переглянути людей зі статусом %(status)s"

#: core/ui/views.py:122 templates/pages/dashboard.html:20
#: templates/pages/dashboard.html:23
msgid "Open People filtered to this lifecycle status."
msgstr ""
"Відкрийте список людей, відфільтрований за цим статусом життєвого циклу."

#: core/ui/views.py:129
#, python-format
msgid "View inactive people: %(reason)s"
msgstr "Переглянути неактивних людей: %(reason)s"

#: core/ui/views.py:132
msgid "Open People filtered to this inactive reason."
msgstr "Відкрийте список людей, відфільтрований за цією причиною неактивності."

